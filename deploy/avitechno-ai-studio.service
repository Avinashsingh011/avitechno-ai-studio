[Unit]
Description=AVI TECHNO AI Studio
After=network.target
[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/avitechno-ai-studio
EnvironmentFile=/opt/avitechno-ai-studio/.env
ExecStart=/opt/avitechno-ai-studio/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8001 --timeout 120 app:application
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
